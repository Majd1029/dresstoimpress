# Copy to .dev.vars for local Worker development. Never commit the completed file.
APP_URL=http://localhost:5173
# Hosted previews remain private until SITE_VISIBILITY is explicitly public.
SITE_VISIBILITY=private
PREVIEW_ACCESS_USER=owner
# Set a new random 32-byte hex password in the PERSONAL Worker secrets.
PREVIEW_ACCESS_PASSWORD=
# Generate a random 32-byte hex token; remove it after creating the first admin.
ADMIN_SETUP_TOKEN=replace_with_random_64_character_hex_token
# Optional bearer token for the scheduled maintenance endpoint.
MAINTENANCE_SECRET=replace_with_a_different_random_64_character_hex_token

# Use sk_test_ and Stripe CLI whsec_ values first. Never put secrets in NEXT_PUBLIC_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe-hosted Checkout does not need a browser publishable key.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_if_you_later_embed_stripe

# Resend API key and a verified sender, e.g. Dress to Impress <orders@your-domain>
EMAIL_API_KEY=
EMAIL_FROM=

# D1 and R2 bindings are declared in wrangler.jsonc.
# The checked-in database ID is local-only; deployment requires verified personal IDs.
# Real R2 activation is pending the owner's billing decision.
# There is no DATABASE_URL or image-storage access key to paste into the frontend.
# D1 is accessed through env.DB; image storage through env.BUCKET.

