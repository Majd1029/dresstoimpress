{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dresstoimpress",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // Local defaults only. The guarded deployment command requires personal IDs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"binding": "ASSETS", "run_worker_first": true},
  "vars": {"APP_URL": "http://localhost:5173", "SITE_VISIBILITY": "private"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dresstoimpress-db",
    "database_id": "00000000-0000-4000-8000-000000000000",
    "migrations_dir": ".migration/schema"
  }],
  // Emulated locally; enabling real R2 requires a separate billing decision.
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "dresstoimpress-media"}]
}
